# Variáveis do painel. Em produção o install.sh gera /home/fivem/.panel/dashboard.env;
# este arquivo serve para rodar o painel em desenvolvimento (cp .env.example .env.local).

PORT=8081
PANEL_TITLE="FiveM Server"
DASHBOARD_PASSWORD=troque-esta-senha
JWT_SECRET=gere-com-openssl-rand-hex-32

# Pastas (layout criado pelo install.sh)
DATA_DIR=/home/fivem/server-data
BACKUP_DIR=/home/fivem/backups
TXDATA_DIR=/home/fivem/txData

# Repositório de resources sincronizado pelo botão "Sync Git"
GIT_REPO=https://github.com/usuario/meu-servidor
GIT_BRANCH=main
GIT_TOKEN=

# MySQL (opcional — habilita backup/restore)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Opcional: envia cada backup também para um webhook do Discord
BACKUP_WEBHOOK_URL=
