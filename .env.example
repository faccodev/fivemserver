#=============================================#
# FiveM Server — Configuração de Ambiente
# Copie este arquivo para .env no servidor:
#   cp .env.example /opt/fivem/server-data/.env
#
# ⚠️  NUNCA commite o .env com segredos!
#     Adicione .env ao .gitignore
#=============================================#

# ---- SERVIDOR DE BANCO (obrigatório) ----
DB_HOST=IP_DO_SERVIDOR_DB
DB_USER=fivem
DB_PASSWORD=SUA_SENHA_DO_BANCO
DB_NAME=creative_tema_proprio
DB_PORT=3306

# ---- FIVEM ----
SV_LICENSE_KEY=cfxk_SUA_LICENSE_KEY
STEAM_WEB_API_KEY=SUA_STEAM_WEB_API_KEY

# ---- REPOSITÓRIO GIT ----
GIT_REPO=https://github.com/faccodev/sindicato_rp.git
# Para repos privados, use o formato com token:
# GIT_REPO=https://x-access-token:ghp_SEU_TOKEN@github.com/faccodev/sindicato_rp.git
GIT_TOKEN=ghp_SEU_GITHUB_TOKEN

# ---- CONFIGURAÇÃO DO SERVIDOR ----
SERVER_IP=IP_PUBLICO_DO_SERVIDOR
SV_MAXCLIENTS=48
GAME_PORT=30120
TXADMIN_PORT=40120

# ---- DASHBOARD ----
DASHBOARD_PASSWORD=CHANGE_ME_DEPOIS_DE_INSTALAR
